{{template "base/head" .}}
<div class="admin login-bans">
	<div class="ui container">
		<div class="ui grid">
			{{template "admin/navbar" .}}
			<div class="twelve wide column content">
				{{template "base/alert" .}}

				<h4 class="ui top attached header">
					{{.i18n.Tr "admin.login_bans"}}
				</h4>
				<div class="ui attached segment">
					<p>{{.i18n.Tr "admin.login_bans.description"}}</p>
					<dl class="dl-horizontal admin-dl-horizontal">
						<dt>{{.i18n.Tr "admin.login_bans.file_path"}}</dt>
						<dd><code>{{.BanStatus.Path}}</code></dd>
						<dt>{{.i18n.Tr "admin.login_bans.file_exists"}}</dt>
						<dd>
							{{if .BanStatus.Exists}}
								<i class="fa fa-check-square-o" aria-hidden="true"></i>
							{{else}}
								{{.i18n.Tr "admin.login_bans.file_missing"}}
							{{end}}
						</dd>
						<dt>{{.i18n.Tr "admin.login_bans.last_loaded"}}</dt>
						<dd>{{if .BanStatus.LastLoadedAt.IsZero}}N/A{{else}}{{DateFmtLong .BanStatus.LastLoadedAt}}{{end}}</dd>
						{{if .BanStatus.LastError}}
							<dt>{{.i18n.Tr "admin.login_bans.load_error"}}</dt>
							<dd>{{.BanStatus.LastError}}</dd>
						{{end}}
						<dt>{{.i18n.Tr "admin.login_bans.skipped"}}</dt>
						<dd>{{.BanStatus.SkippedCount}}</dd>
						<dt>{{.i18n.Tr "admin.login_bans.expired"}}</dt>
						<dd>{{.BanStatus.ExpiredCount}}</dd>
					</dl>
					<form action="{{AppSubURL}}/admin/login-bans/reload" method="post">
						<button class="ui primary button" type="submit">{{.i18n.Tr "admin.login_bans.reload"}}</button>
					</form>
				</div>

				<h4 class="ui top attached header">
					{{.i18n.Tr "admin.login_bans.add_ban"}}
				</h4>
				<div class="ui attached segment">
					<form class="ui form" action="{{AppSubURL}}/admin/login-bans/ban" method="post">
						<div class="required field">
							<label for="ban-kind">{{.i18n.Tr "admin.login_bans.ban_kind"}}</label>
							<select id="ban-kind" name="kind" required>
								<option value="ip">{{.i18n.Tr "admin.login_bans.ban_kind_ip"}}</option>
								<option value="account">{{.i18n.Tr "admin.login_bans.ban_kind_account"}}</option>
							</select>
						</div>
						<div class="required field">
							<label for="ban-value">{{.i18n.Tr "admin.login_bans.ban_value"}}</label>
							<input id="ban-value" name="value" type="text" required placeholder="{{.i18n.Tr "admin.login_bans.ban_value_placeholder"}}">
						</div>
						<div class="required field">
							<label for="ban-duration">{{.i18n.Tr "admin.login_bans.ban_duration"}}</label>
							<input id="ban-duration" name="durationMinutes" type="number" min="1" max="525600" step="1" aria-describedby="ban-duration-help" required>
							<p class="help" id="ban-duration-help">{{.i18n.Tr "admin.login_bans.ban_duration_helper"}}</p>
						</div>
						<div class="field">
							<label for="ban-reason">{{.i18n.Tr "admin.login_bans.ban_reason"}}</label>
							<input id="ban-reason" name="reason" type="text" placeholder="{{.i18n.Tr "admin.login_bans.ban_reason_placeholder"}}">
						</div>
						<button class="ui red button" type="submit">{{.i18n.Tr "admin.login_bans.ban_submit"}}</button>
					</form>
				</div>

				<h4 class="ui top attached header">
					{{.i18n.Tr "admin.login_bans.ip_bans"}}
				</h4>
				<div class="ui unstackable attached table segment">
					<table class="ui unstackable very basic striped table">
						<thead>
							<tr>
								<th>{{.i18n.Tr "admin.login_bans.value"}}</th>
								<th>{{.i18n.Tr "admin.login_bans.until"}}</th>
								<th>{{.i18n.Tr "admin.login_bans.remaining"}}</th>
								<th>{{.i18n.Tr "admin.login_bans.created"}}</th>
								<th>{{.i18n.Tr "admin.login_bans.last_login"}}</th>
								<th>{{.i18n.Tr "admin.login_bans.reason"}}</th>
								<th>{{.i18n.Tr "admin.login_bans.actions"}}</th>
							</tr>
						</thead>
						<tbody>
							{{range .IPBans}}
								<tr>
									<td>{{.Value}}</td>
									<td>{{DateFmtLong .Until}}</td>
									<td>{{.Remaining}}</td>
									<td>{{if .Created.IsZero}}N/A{{else}}{{DateFmtLong .Created}}{{end}}</td>
									<td>{{.LastLogin}}</td>
									<td>{{.Reason}}</td>
									<td>
										<form class="inline-form" action="{{AppSubURL}}/admin/login-bans/unban" method="post">
											<input type="hidden" name="kind" value="ip">
											<input type="hidden" name="value" value="{{.Value}}">
											<button class="ui red small button" type="submit" aria-label="{{$.i18n.Tr "admin.login_bans.unban"}} {{.Value}}">{{$.i18n.Tr "admin.login_bans.unban"}}</button>
										</form>
									</td>
								</tr>
							{{end}}
							{{if not .IPBans}}
								<tr>
									<td colspan="7">{{.i18n.Tr "admin.login_bans.no_bans"}}</td>
								</tr>
							{{end}}
						</tbody>
					</table>
				</div>

				<h4 class="ui top attached header">
					{{.i18n.Tr "admin.login_bans.account_bans"}}
				</h4>
				<div class="ui unstackable attached table segment">
					<table class="ui unstackable very basic striped table">
						<thead>
							<tr>
								<th>{{.i18n.Tr "admin.login_bans.account_value"}}</th>
								<th>{{.i18n.Tr "admin.login_bans.until"}}</th>
								<th>{{.i18n.Tr "admin.login_bans.remaining"}}</th>
								<th>{{.i18n.Tr "admin.login_bans.created"}}</th>
								<th>{{.i18n.Tr "admin.login_bans.reason"}}</th>
								<th>{{.i18n.Tr "admin.login_bans.actions"}}</th>
							</tr>
						</thead>
						<tbody>
							{{range .AccountBans}}
								<tr>
									<td>{{.Value}}</td>
									<td>{{DateFmtLong .Until}}</td>
									<td>{{.Remaining}}</td>
									<td>{{if .Created.IsZero}}N/A{{else}}{{DateFmtLong .Created}}{{end}}</td>
									<td>{{.Reason}}</td>
									<td>
										<form class="inline-form" action="{{AppSubURL}}/admin/login-bans/unban" method="post">
											<input type="hidden" name="kind" value="account">
											<input type="hidden" name="value" value="{{.Value}}">
											<button class="ui red small button" type="submit" aria-label="{{$.i18n.Tr "admin.login_bans.unban"}} {{.Value}}">{{$.i18n.Tr "admin.login_bans.unban"}}</button>
										</form>
									</td>
								</tr>
							{{end}}
							{{if not .AccountBans}}
								<tr>
									<td colspan="6">{{.i18n.Tr "admin.login_bans.no_bans"}}</td>
								</tr>
							{{end}}
						</tbody>
					</table>
				</div>
			</div>
		</div>
	</div>
</div>
{{template "base/footer" .}}
